---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import { reports } from '../../data/reports';
---

<BaseLayout
  title="Isitha's Technical Reports"
  description="Technical reports by Isitha Subasinghe on distributed systems, high-performance computing, and computer science."
>
  <h1>Technical Reports</h1>
  <Nav />
  <p>Long-form technical work, rendered directly for the web.</p>

  <div class="report-list">
    {reports.map((report) => (
      <article class="report-card">
        <h2>
          <a href={`/reports/${report.slug}`}>{report.title}</a>
        </h2>
        <p>{report.description}</p>
        <div class="report-meta">{report.topics.join(' · ')}</div>
      </article>
    ))}
  </div>
</BaseLayout>

<style>
  .report-card {
    border-top: 1px solid #ddd;
    padding-top: 1.25rem;
  }

  .report-list {
    display: grid;
    gap: 2rem;
    margin-top: 2rem;
  }

  .report-card h2 {
    font-size: 1.25rem;
    line-height: 1.4;
    margin: 0 0 0.65rem;
  }

  .report-card h2 a {
    font-size: inherit;
  }

  .report-card p {
    line-height: 1.6;
    margin: 0 0 0.75rem;
  }

  .report-meta {
    color: #666;
    font-size: 0.85rem;
  }
</style>
