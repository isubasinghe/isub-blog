---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/wiki/Breadcrumbs.astro';
import WikiGraph from '../../components/wiki/Graph.tsx';
import { buildLinkIndex, graphData } from '../../lib/wiki/graph';

const entries = await getCollection('wiki');
const index = buildLinkIndex(entries);
const data = graphData(entries, index);
---

<BaseLayout title="Wiki — Graph" description="Wiki link graph">
  <Breadcrumbs id="index" entries={entries} />
  <h1>Link graph</h1>
  <p>Click a node to jump to that page.</p>
  <WikiGraph data={data} client:only="solid-js" />
</BaseLayout>
