---
import type { CollectionEntry } from 'astro:content';
import { buildPageTree } from '../../lib/wiki/tree';
import { entryToUrl } from '../../lib/wiki/graph';
import PageTree from './PageTree.astro';

interface Props {
  /** Parent folder id, e.g. "concurrency" or "index"/"README" for the root. */
  parentId: string;
  entries: CollectionEntry<'wiki'>[];
  currentId?: string;
}

const { parentId, entries, currentId } = Astro.props;
const nodes = buildPageTree(parentId, entries);
const hasBranches = nodes.some((node) => node.children.length > 0);
const currentUrl = currentId ? entryToUrl(currentId) : undefined;
---

{nodes.length > 0 && (
  <section class="wiki-children">
    <div class="tree-heading">
      <h2>Browse pages</h2>
      {hasBranches && (
        <div class="tree-controls" hidden>
          <button type="button" data-tree-action="expand">Expand all</button>
          <button type="button" data-tree-action="collapse">Collapse all</button>
        </div>
      )}
    </div>
    {hasBranches && <p class="tree-hint">Use the arrows to explore topics, or a page title to read it.</p>}
    <nav aria-label="Wiki pages">
      <PageTree nodes={nodes} currentUrl={currentUrl} />
    </nav>
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>('.wiki-children').forEach((section) => {
    const controls = section.querySelector<HTMLElement>('.tree-controls');
    if (!controls) return;
    controls.hidden = false;
    controls.querySelectorAll<HTMLButtonElement>('button').forEach((button) => {
      button.addEventListener('click', () => {
        const open = button.dataset.treeAction === 'expand';
        section.querySelectorAll('details').forEach((branch) => {
          branch.open = open;
        });
      });
    });
  });
</script>

<style>
  .tree-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  .tree-heading h2 {
    margin: 0;
  }

  .tree-controls:not([hidden]) {
    display: flex;
    gap: 1rem;
  }

  button {
    padding: 0.5rem 0;
    border: 0;
    background: none;
    color: #1768ac;
    font: inherit;
    font-size: 0.875rem;
    text-decoration: underline;
    text-underline-offset: 0.15em;
    cursor: pointer;
  }

  button:focus-visible {
    outline: 2px solid #1768ac;
    outline-offset: 3px;
  }

  .tree-hint {
    margin: 0.5rem 0 1rem;
    color: #666;
    font-size: 0.875rem;
    line-height: 1.5;
  }
</style>
