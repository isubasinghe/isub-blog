---
import type { CollectionEntry } from 'astro:content';
import { childrenOf } from '../../lib/wiki/paths';
import { entryToUrl, displayTitle } from '../../lib/wiki/graph';

interface Props {
  /** Parent folder id, e.g. "concurrency" or "index"/"README" for the root. */
  parentId: string;
  entries: CollectionEntry<'wiki'>[];
}

const { parentId, entries } = Astro.props;
const children = childrenOf(parentId, entries).sort((a, b) =>
  displayTitle(a).localeCompare(displayTitle(b))
);
---

{children.length > 0 && (
  <section class="wiki-children">
    <h2>Pages</h2>
    <ul>
      {children.map((c) => (
        <li>
          <a href={entryToUrl(c.id)}>{displayTitle(c)}</a>
          {c.data.description && <span class="desc"> — {c.data.description}</span>}
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  ul {
    list-style: none;
    padding: 0;
  }
  li {
    padding: 0.35rem 0;
  }
  .desc {
    color: #666;
    font-size: 0.95rem;
  }
</style>
