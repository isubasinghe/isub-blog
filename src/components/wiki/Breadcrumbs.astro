---
import { breadcrumbs, knownFolderIndexes } from '../../lib/wiki/paths';

interface Props {
  /** Wiki entry id (e.g. "concurrency/atomic-ops" or "index"). */
  id: string;
  /**
   * Optional collection entries. Used to skip linking breadcrumb segments
   * whose folder has no `README.md` / `index.md` — those URLs would 404.
   */
  entries?: { id: string }[];
}

const { id, entries } = Astro.props;
const folderIndexes = entries ? knownFolderIndexes(entries) : undefined;
const crumbs = breadcrumbs(id, folderIndexes);
---

<nav class="wiki-breadcrumbs" aria-label="Breadcrumb">
  <a href="/">Home</a>
  {crumbs.map((c) => (
    <>
      <span class="sep"> › </span>
      {c.current || c.url === null
        ? <span>{c.label}</span>
        : <a href={c.url}>{c.label}</a>}
    </>
  ))}
</nav>

<style>
  .sep {
    color: #999;
    padding: 0 0.25rem;
  }
</style>
