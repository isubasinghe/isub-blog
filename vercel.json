{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(?!robots\\.txt$).*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(GPTBot|OAI-SearchBot|ChatGPT-User|ClaudeBot|Claude-SearchBot|Claude-User|PerplexityBot|Perplexity-User|CCBot|Amazonbot|Bytespider|cohere-ai|Diffbot|meta-externalagent|meta-externalfetch|YouBot).*"
        }
      ],
      "mitigate": {
        "action": "deny"
      }
    }
  ]
}
